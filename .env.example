# Copy to .env (repo root or backend/) and fill in what you need. Everything is optional.

# --- LLM -------------------------------------------------------------
# auto: use Gemini when GEMINI_API_KEY is set, otherwise the offline simulator
LLM_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Storage -----------------------------------------------------------
# DATABASE_URL=sqlite:///./signalchain.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/signalchain

# --- A2A -----------------------------------------------------------------
# "inprocess" = real JSON-RPC over an in-process ASGI transport.
# Set to a URL (e.g. https://crew.example.com/a2a/crewai) to call a separately deployed CrewAI agent.
A2A_CREWAI_URL=inprocess
PUBLIC_BASE_URL=http://localhost:8000

# --- Tools -----------------------------------------------------------------
ENABLE_EXTERNAL_APIS=true

# --- Observability (optional Langfuse export) ---------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
